{
    "name": "gsebastiao/laravel-settings",
    "description": "Settings para Laravel guardadas na base de dados: valores globais, por utilizador e por tenant, com tipos automáticos e cache.",
    "type": "library",
    "keywords": [
        "laravel",
        "settings",
        "configuration",
        "preferences",
        "user-settings",
        "multi-tenant"
    ],
    "homepage": "https://github.com/gsebastiao/laravel-settings",
    "license": "MIT",
    "authors": [
        {
            "name": "Gerson Sebastião Cossa",
            "homepage": "https://github.com/gsebastiao",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/gsebastiao/laravel-settings/issues",
        "source": "https://github.com/gsebastiao/laravel-settings"
    },
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gsebastiao\\LaravelSettings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gsebastiao\\LaravelSettings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsebastiao\\LaravelSettings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "Gsebastiao\\LaravelSettings\\Facades\\Settings"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
